# Source target discovered on 2026-10-21. Verify before using elsewhere.
AMAZON_PG_CONTAINER=postgres-local
AMAZON_DATABASE=tunglocaldb
# With AMAZON_PG_CONTAINER empty, use a local psql and PGHOST/PGUSER/PGPASSFILE.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=your_existing_user
# PGPASSFILE=/absolute/path/to/private/pgpass

SUPERSET_URL=http://localhost:8088
# This existing connection was confirmed to target tunglocaldb.
SUPERSET_DATABASE_ID=2
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
# Or set an existing short-lived access token in your shell:
# SUPERSET_ACCESS_TOKEN=
